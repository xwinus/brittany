cabal-version: 2.2

name:                 brittany
version:              0.15.0.0
synopsis:             Haskell source code formatter
description:
  See <https://github.com/xwinus/brittany/blob/master/README.md the README>.
  .
  If you are interested in the implementation, have a look at <https://github.com/xwinus/brittany/blob/master/doc/implementation/theory.md this document>;
  .
  The implementation is documented in more detail <https://github.com/xwinus/brittany/blob/master/doc/implementation/index.md here>.
license:              AGPL-3.0-only
license-file:         LICENSE
author:               Lennart Spitzner
maintainer:           xwinus
copyright:            Copyright (C) 2016-2019 Lennart Spitzner
                      Copyright (C) 2019 PRODA LTD
                      Copyright (C) 2026 xwinus
category:             Language
build-type:           Simple
homepage:             https://github.com/xwinus/brittany/
bug-reports:          https://github.com/xwinus/brittany/issues
extra-doc-files:
  ChangeLog.md
  README.md
  doc/compatibility.md
  doc/fallbacks.md
  doc/implementation/*.md
extra-source-files:
  cabal.project
  data/brittany.yaml
  data/compatibility.yaml
  data/maintained-source-files.txt
  data/*.hs
  scripts/fallback-inventory.sh
  source/test-suite/fixtures/*.hs

source-repository head
  type: git
  location: https://github.com/xwinus/brittany.git

flag pedantic
  default: False
  description: Enables @-Werror@, which turns warnings into errors.
  manual: True

common library
  build-depends:
    , aeson ^>= 2.2
    , base ^>= 4.22.0
    , butcher ^>= 1.3.3
    , bytestring ^>= 0.12
    , cmdargs ^>= 0.10.21
    , containers ^>= 0.8
    , czipwith ^>= 1.0.1
    , data-tree-print ^>= 0.1.0
    , deepseq ^>= 1.5
    , directory ^>= 1.3.6
    , extra ^>= 1.8
    , filepath ^>= 1.5
    , ghc ^>= 9.14
    , ghc-boot ^>= 9.14
    , ghc-boot-th ^>= 9.14
    , ghc-exactprint ^>= 1.14.0
    , ghc-paths ^>= 0.1.0
    , monad-memo ^>= 0.5.3
    , mtl ^>= 2.3
    , multistate ^>= 0.8.0
    , pretty ^>= 1.1.3
    , random ^>= 1.2.1
    , safe ^>= 0.3.19
    , semigroups ^>= 0.19.2
    , strict ^>= 0.5
    , syb ^>= 0.7.2
    , text ^>= 2.1
    , transformers ^>= 0.6
    , uniplate ^>= 1.6.13
    , yaml ^>= 0.11.7
  default-language: Haskell2010
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-incomplete-uni-patterns
    -Wno-missing-deriving-strategies
    -Wno-missing-export-lists
    -Wno-missing-import-lists
    -Wno-missing-local-signatures
    -Wno-missing-safe-haskell-mode
    -Wno-monomorphism-restriction
    -Wno-prepositive-qualified-module
    -Wno-safe
    -Wno-unsafe

  if flag(pedantic)
    ghc-options: -Werror

common executable
  import: library

  build-depends: brittany
  ghc-options:
    -rtsopts
    -threaded
    -Wno-implicit-prelude
    -Wno-unused-packages

library
  import: library

  autogen-modules: Paths_brittany
  hs-source-dirs: source/library
  exposed-modules:
    Language.Haskell.Brittany
    Language.Haskell.Brittany.Internal
    Language.Haskell.Brittany.Internal.Backend
    Language.Haskell.Brittany.Internal.BackendUtils
    Language.Haskell.Brittany.Internal.CommentPlan
    Language.Haskell.Brittany.Internal.CommentBoundary
    Language.Haskell.Brittany.Internal.Config
    Language.Haskell.Brittany.Internal.Config.Types
    Language.Haskell.Brittany.Internal.Config.Types.Instances
    Language.Haskell.Brittany.Internal.ExactPrintCompat
    Language.Haskell.Brittany.Internal.ExactPrintUtils
    Language.Haskell.Brittany.Internal.ExactSource
    Language.Haskell.Brittany.Internal.ExtractAnns
    Language.Haskell.Brittany.Internal.Fallbacks
    Language.Haskell.Brittany.Internal.LayouterBasics
    Language.Haskell.Brittany.Internal.Layouters.DataDecl
    Language.Haskell.Brittany.Internal.Layouters.DataDecl.Constructor
    Language.Haskell.Brittany.Internal.Layouters.Decl
    Language.Haskell.Brittany.Internal.Layouters.Expr
    Language.Haskell.Brittany.Internal.Layouters.FixitySignature
    Language.Haskell.Brittany.Internal.Layouters.IE
    Language.Haskell.Brittany.Internal.Layouters.Import
    Language.Haskell.Brittany.Internal.Layouters.Instance
    Language.Haskell.Brittany.Internal.Layouters.Module
    Language.Haskell.Brittany.Internal.Layouters.Pattern
    Language.Haskell.Brittany.Internal.Layouters.StandaloneDeriving
    Language.Haskell.Brittany.Internal.Layouters.StandaloneKindSignature
    Language.Haskell.Brittany.Internal.Layouters.Stmt
    Language.Haskell.Brittany.Internal.Layouters.Type
    Language.Haskell.Brittany.Internal.Obfuscation
    Language.Haskell.Brittany.Internal.ParseModule
    Language.Haskell.Brittany.Internal.Prelude
    Language.Haskell.Brittany.Internal.PreludeUtils
    Language.Haskell.Brittany.Internal.SemanticFingerprint
    Language.Haskell.Brittany.Internal.TransactionalWrite
    Language.Haskell.Brittany.Internal.SourceComment.Types
    Language.Haskell.Brittany.Internal.Transformations.Alt
    Language.Haskell.Brittany.Internal.Transformations.Columns
    Language.Haskell.Brittany.Internal.Transformations.Floating
    Language.Haskell.Brittany.Internal.Transformations.Indent
    Language.Haskell.Brittany.Internal.Transformations.Par
    Language.Haskell.Brittany.Internal.TopLevelSpacing
    Language.Haskell.Brittany.Internal.Types
    Language.Haskell.Brittany.Internal.Utils
    Language.Haskell.Brittany.Main
    Paths_brittany
  other-modules:
    Language.Haskell.Brittany.Internal.CommentUtils
    Language.Haskell.Brittany.Internal.ConstructorComments
    Language.Haskell.Brittany.Internal.ExpressionComments
    Language.Haskell.Brittany.Internal.Layouters.DataDecl.Boundary
    Language.Haskell.Brittany.Internal.Layouters.DataDecl.Deriving
    Language.Haskell.Brittany.Internal.Layouters.DataDecl.Support
    Language.Haskell.Brittany.Internal.Layouters.Pattern.Comments
    Language.Haskell.Brittany.Internal.Layouters.Pattern.Record
    Language.Haskell.Brittany.Internal.Layouters.Pattern.Types
    Language.Haskell.Brittany.Internal.Layouters.Type.Operator
    Language.Haskell.Brittany.Internal.PatternComments
    Language.Haskell.Brittany.Internal.Preprocessor
    Language.Haskell.Brittany.Internal.SemanticFingerprint.Ghc
    Language.Haskell.Brittany.Internal.SemanticModel
    Language.Haskell.Brittany.Internal.TypeFallbacks
    Language.Haskell.Brittany.Main.Transform

executable brittany
  import: executable

  hs-source-dirs: source/executable
  main-is: Main.hs

test-suite brittany-test-suite
  import: executable

  build-depends:
    , hspec >= 2.8.3
    , process ^>= 1.6.26
  hs-source-dirs: source/test-suite
  main-is: Main.hs
  other-modules:
    TransactionalInplaceSpec
    CanonicalSemanticModelSpec
    CompatibilityMatrix
    CompatibilitySpec
    CommentPlanSpec
    CommentOwnershipSpec
    CommentBoundaryGraphSpec
    CompactParenthesizedPatternSpec
    CompositionalPatternSpec
    ComposableDeclarationSpec
    ConstructorBoundarySpec
    ConstructorFieldModifierSpec
    DataDeclSingleConstructorSpec
    DelimiterLayoutSpec
    ExtractAnnsSpec
    ExactSourceFragmentSpec
    FallbackSpec
    FallbackSweepSpec
    FixitySignatureSpec
    InstanceHeadSpec
    LetStatementBoundarySpec
    OpaqueSyntaxSpec
    PatternSynonymBindingSpec
    PreambleSpacingSpec
    PreprocessorSpec
    PriorCommentSeparationSpec
    PrefixConstructorIndentationSpec
    RecordFieldRhsIndentSpec
    RegressionSpec
    SemanticFingerprintSpec
    SignaturePostDocSpec
    SiblingBindingAlignmentSpec
    StandaloneDerivingSpec
    StandaloneKindSignatureSpec
    StructuralCommentSpec
    TemplateHaskellFallbackSpec
    TopLevelSpacingSpec
    TypeOperatorRecordSpec
    TupleSemanticNameSpec
  type: exitcode-stdio-1.0
